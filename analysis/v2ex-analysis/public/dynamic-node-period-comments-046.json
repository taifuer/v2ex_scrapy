312,"topic_period":"2014-07"},"1236194":{"id":1236194,"topic_id":124591,"commenter":"Danfi","thank_count":1,"no":4,"topic_title":"[团购需求收集]Ingress 官方周边的海淘团购","content":"前天刚下单买了 — —","create_at":1406368764,"topic_period":"2014-07"},"1315643":{"id":1315643,"topic_id":130237,"commenter":"47jm9ozp","thank_count":1,"no":6,"topic_title":"Ingress for iOS 1.58 更新","content":"@sutking https://support.google.com/ingress/answer/2808254?hl=en&ref_topic=3261457 'From the gallery'","create_at":1409553560,"topic_period":"2014-08"},"1907276":{"id":1907276,"topic_id":178047,"commenter":"Elethom","thank_count":1,"no":2,"topic_title":"今天在西三旗看到了 @rrfeng 的 portal shields","content":"@WildCat\n下週二回上海。","create_at":1426767210,"topic_period":"2015-03"},"1907393":{"id":1907393,"topic_id":178047,"commenter":"rrfeng","thank_count":1,"no":3,"topic_title":"今天在西三旗看到了 @rrfeng 的 portal shields","content":"绿军你好，绿军再见。","create_at":1426770604,"topic_period":"2015-03"},"1965741":{"id":1965741,"topic_id":182872,"commenter":"raincious","thank_count":1,"no":5,"topic_title":"帝都有多少人玩 ingress？","content":"一个Portal在不装HS和MH的情况下，4小时内（？）只能Hack 4次，最多一个人会在那儿等上4 * 5 = 20分钟，于是也就是路过下然后就走了，剩下的时间（4小时-20分钟）这个Portal是过热状态，任何人都不能Hack的。\n不过楼主可以试试看装满MH，不要装HS，这样等的人会多一些。当然，周围不要装监视器和录音器，也不要兜售美甲服务以及贴罚单+代销罚名片。咖啡好的话可能会有玩家顺路光顾的。","create_at":1428659503,"topic_period":"2015-04"},"1966202":{"id":1966202,"topic_id":182872,"commenter":"myang","thank_count":1,"no":10,"topic_title":"帝都有多少人玩 ingress？","content":"@raincious 过热只对hack完4次的那个人有效，不影响其他人hack。","create_at":1428672661,"topic_period":"2015-04"},"2044578":{"id":2044578,"topic_id":189672,"commenter":"timbotetsu","thank_count":4,"no":1,"topic_title":"上海蓝色 Ingress Portal 最密集的地方在哪？","content":"西营路：地铁7号线长清路出来往西南方向走200米\n莲中路：公交715路南下终点站出来西南方向走200米\n淮海中路（陕西南路淮海中路交叉）：地铁1号线陕西南路3号口后出来即为战场\n八佰伴：地铁9号线商城路出来\n雕塑公园：地铁2号线南京西路出来往西北方向走200米\n红坊：地铁4号线、地铁10号线虹桥路出来往东北方向走200米\n花木玉兰广场（又名一脚七）：地铁2号线世纪公园出来西南方向走300米\n另外各大公园都有十分密集的Portal，比如卢湾的复兴公园、闸北的和平公园、张江的紫薇公园\n如果Livid你下午有时间，而且你是蓝军，邀请你参加我们下午2点在江浦公园的活动 :)","create_at":1431137989,"topic_period":"2015-05"},"2044585":{"id":2044585,"topic_id":189672,"commenter":"rrfeng","thank_count":2,"no":2,"topic_title":"上海蓝色 Ingress Portal 最密集的地方在哪？","content":"@timbotetsu 已经暴露……大波绿军已抵达……","create_at":1431138097,"topic_period":"2015-05"},"2044636":{"id":2044636,"topic_id":189672,"commenter":"Livid","thank_count":6,"no":16,"topic_title":"上海蓝色 Ingress Portal 最密集的地方在哪？","content":"嘿嘿，我是绿军 :P","create_at":1431139321,"topic_period":"2015-05"},"2044684":{"id":2044684,"topic_id":189672,"commenter":"viikker","thank_count":2,"no":22,"topic_title":"上海蓝色 Ingress Portal 最密集的地方在哪？","content":"目前 红坊是蓝，等级较低，可以去。","create_at":1431140003,"topic_period":"2015-05"},"2044751":{"id":2044751,"topic_id":189672,"commenter":"timbotetsu","thank_count":2,"no":37,"topic_title":"上海蓝色 Ingress Portal 最密集的地方在哪？","content":"@Livid 如果等级还未满8的话，推荐你可以先找附近大腿抱一抱，刚开始先插Res、Link Portal和做CF，等级低，打高等级的Portal很容易电疗到挂，毕竟还不能使用高等级的X","create_at":1431140912,"topic_period":"2015-05"},"2046238":{"id":2046238,"topic_id":123460,"commenter":"summic","thank_count":3,"no":17,"topic_title":"Google 应该已经通过 Ingress 收集到不少数据了，你觉得这些数据能够用来做什么呢？","content":"估计是为了出版一本《中国石狮子大全图册》","create_at":1431182982,"topic_period":"2014-07"},"2063103":{"id":2063103,"topic_id":189680,"commenter":"alex321","thank_count":1,"no":78,"topic_title":"e，我还有 116 个 ingress 邀请。求散出。","content":"@userlogin 发了","create_at":1431667460,"topic_period":"2015-05"},"2083838":{"id":2083838,"topic_id":193083,"commenter":"Biwood","thank_count":1,"no":1,"topic_title":" 在北京刷一下存在感","content":"好吧，我信了。。。跟站长第一次亲密接触，好激动。。。","create_at":1432302671,"topic_period":"2015-05"},"2083942":{"id":2083942,"topic_id":193083,"commenter":"ccbikai","thank_count":6,"no":19,"topic_title":" 在北京刷一下存在感","content":"怎么证明？\n你去看看你的V2EX账号还能发帖吗？\n哈哈哈","create_at":1432305518,"topic_period":"2015-05"},"2093143":{"id":2093143,"topic_id":193712,"commenter":"Cater","thank_count":1,"no":14,"topic_title":"[Ingress 代购需求收集] Persepolis Pack","content":"@Tyler1989 @zhengkejian0 @leonzhao @GhostFlying\n有意的话给我发个邮件吧～[email protected]\n邮件里请提供Telegram或者其他更加有效的联系方式，我们再详谈。争取这周末之前下单。\n咱们5、6个人分运费应该稳稳的了。\n其他人有意的话本周末之前都有效哦～","create_at":1432621927,"topic_period":"2015-05"},"2641073":{"id":2641073,"topic_id":237178,"commenter":"Xs0ul","thank_count":1,"no":3,"topic_title":"Ingress 三周年 bonus","content":"3 9 13 15 16 分别对应 5 种牌子\n冲下 13 试试好了","create_at":1447861219,"topic_period":"2015-11"},"2828600":{"id":2828600,"topic_id":251518,"commenter":"47jm9ozp","thank_count":1,"no":4,"topic_title":"现在 iOS 版的 ingress 不能添加新的 portal 了？","content":"都不行了，大概是去年年中还是什么时候关闭的\n现在猩猩忙着在搞宠物小精灵，没时间审 po ，堆着越来越多也难受干脆就关掉申请了","create_at":1453090523,"topic_period":"2016-01"},"2828682":{"id":2828682,"topic_id":251518,"commenter":"sotilsy","thank_count":1,"no":7,"topic_title":"现在 iOS 版的 ingress 不能添加新的 portal 了？","content":"去年 8 月份左右不再接受 Portal 申请。\n话说刚开始我还以为是我申请 Portal 过多被封了… = =","create_at":1453092283,"topic_period":"2016-01"},"2828723":{"id":2828723,"topic_id":251518,"commenter":"Phariel","thank_count":1,"no":10,"topic_title":"现在 iOS 版的 ingress 不能添加新的 portal 了？","content":"@sutking 口袋妖怪 GO\n《口袋妖怪 Go 》（英语： Pokémon GO ）是一款即将发布的移动平台另類實境遊戲，由任天堂、口袋妖怪公司和 Niantic, Inc.合作开发。\nNiantic 就是 Ingress 的开发公司， so...","create_at":1453093071,"topic_period":"2016-01"},"3222931":{"id":3222931,"topic_id":281804,"commenter":"Balthild","thank_count":2,"no":19,"topic_title":"Hack 一个 Portal 的频率多少为好？","content":"@hx1997 我也是高三","create_at":1464536229,"topic_period":"2016-05"},"3223720":{"id":3223720,"topic_id":281804,"commenter":"Balthild","thank_count":1,"no":21,"topic_title":"Hack 一个 Portal 的频率多少为好？","content":"@hx1997 话说，用 AXA Refactor 搞掉地铁站 B1 的 PO ，意义大不大？","create_at":1464574216,"topic_period":"2016-05"},"3224392":{"id":3224392,"topic_id":281804,"commenter":"hx1997","thank_count":2,"no":22,"topic_title":"Hack 一个 Portal 的频率多少为好？","content":"@Balthild 不大，一般不是 L8 po 没必要用毒。况且那几个绿军在附近很活跃，马上会打回来，有点得不偿失。","create_at":1464582456,"topic_period":"2016-05"},"3358487":{"id":3358487,"topic_id":291712,"commenter":"EchoChan","thank_count":2,"no":2,"topic_title":"在国内玩 Ingress 的各位，如何解决地图偏移问题？","content":"https://www.ingressplay.com/iitcinstall/ 可以参考。\n但不是在客户端上进行修改的。","create_at":1468218730,"topic_period":"2016-07"},"3359778":{"id":3359778,"topic_id":291786,"commenter":"47jm9ozp","thank_count":1,"no":8,"topic_title":"选蓝还是绿啊","content":"follow your heart","create_at":1468244862,"topic_period":"2016-07"},"3359783":{"id":3359783,"topic_id":291786,"commenter":"shakespaces","thank_count":1,"no":9,"topic_title":"选蓝还是绿啊","content":"绿军欢迎你","create_at":1468244989,"topic_period":"2016-07"},"3360213":{"id":3360213,"topic_id":291786,"commenter":"47jm9ozp","thank_count":1,"no":12,"topic_title":"选蓝还是绿啊","content":"@cdffh 欢迎加入绿军，找本地组织抱大腿吧，应该有各种教程或者补给\n游戏里的偏移无视就好了，没办法，只要 po 位置是准的就能玩\nintel 地图的话用 IITC+中国地图偏移 fix 可以解决","create_at":1468256169,"topic_period":"2016-07"},"3361427":{"id":3361427,"topic_id":291786,"commenter":"47jm9ozp","thank_count":1,"no":16,"topic_title":"选蓝还是绿啊","content":"@cdffh 哈哈哈哈哈……重新注册个或者直接玩下去都好，看你自己想法了\n地图是偏的， po 和 gps 和卫星图是一致的","create_at":1468298743,"topic_period":"2016-07"},"3368198":{"id":3368198,"topic_id":292394,"commenter":"supernova16","thank_count":1,"no":12,"topic_title":"觉得 Ingress 比 Pokemon Go 好玩，附 Ingress 邀请，有新人礼包","content":"@tianxiaqu123 已邀","create_at":1468467116,"topic_period":"2016-07"},"3372408":{"id":3372408,"topic_id":292394,"commenter":"ranye","thank_count":1,"no":89,"topic_title":"觉得 Ingress 比 Pokemon Go 好玩，附 Ingress 邀请，有新人礼包","content":"不要听楼主的，大家务必选蓝军（ Resistence ），一同抵御 Shaper 的入侵","create_at":1468561995,"topic_period":"2016-07"},"4428968":{"id":4428968,"topic_id":292872,"commenter":"Neilyo","thank_count":1,"no":32,"topic_title":"IT 业者是不是绿军比较多？","content":"绿妹没有蓝妹好看 长绿飘过","create_at":1497526417,"topic_period":"2016-07"},"6409038":{"id":6409038,"topic_id":504866,"commenter":"imdong","thank_count":1,"no":3,"topic_title":"ingress prime 出了","content":"懒了很久了...","create_at":1541468575,"topic_period":"2018-11"}}}