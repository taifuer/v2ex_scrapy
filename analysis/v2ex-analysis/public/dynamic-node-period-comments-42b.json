21,"commenter":"choujiaojiao","thank_count":3,"no":1,"topic_title":"等个美区的车上车，之前两年的车主不干了，我非常稳定","content":"https://daixiahu.co/#/buses?license_id=3&region_id=0","create_at":1685004315,"topic_period":"2023-05"},"13853111":{"id":13853111,"topic_id":986867,"commenter":"supermoon","thank_count":1,"no":7,"topic_title":"只有我感觉 spotify 的周推很烂吗","content":"个人听电子比较多，Spotify 的算法 还算精准","create_at":1698715237,"topic_period":"2023-10"},"13853179":{"id":13853179,"topic_id":986867,"commenter":"UKnowMe","thank_count":1,"no":8,"topic_title":"只有我感觉 spotify 的周推很烂吗","content":"怎么我感觉挺不错的，甚至有时候听一些泄曲（非歌手本人发布），周推都能推给我相同歌手的泄曲，因此还能发现不少的好歌。","create_at":1698715642,"topic_period":"2023-10"},"13881969":{"id":13881969,"topic_id":986867,"commenter":"marcosteam","thank_count":1,"no":13,"topic_title":"只有我感觉 spotify 的周推很烂吗","content":"因为 Spotify 和 Apple Music 不会特意去区分 [用户泛听内容] 和 [用户喜爱内容] 。\n我举个例子，我也是 Spotify 和 Apple Music 的重度用户，工作或者学习的时候喜欢听 Lo-Fi 音乐歌单，但是一般打开播放以后就不管它了，没有做任何喜爱的操作，然后就这样过了两个星期左右，我的推荐全部就乱了，全是 Lo-Fi 音乐了。","create_at":1699111815,"topic_period":"2023-10"},"14011085":{"id":14011085,"topic_id":996431,"commenter":"inhzus","thank_count":3,"no":7,"topic_title":"看看大家的 Spotify 年度总结","content":"[图片]","create_at":1701311442,"topic_period":"2023-11"},"14011175":{"id":14011175,"topic_id":996431,"commenter":"mogita","thank_count":10,"no":9,"topic_title":"看看大家的 Spotify 年度总结","content":"[图片]","create_at":1701312009,"topic_period":"2023-11"},"14011292":{"id":14011292,"topic_id":996431,"commenter":"isbase","thank_count":1,"no":14,"topic_title":"看看大家的 Spotify 年度总结","content":"[图片]","create_at":1701312856,"topic_period":"2023-11"},"14011519":{"id":14011519,"topic_id":996431,"commenter":"Yadomin","thank_count":5,"no":19,"topic_title":"看看大家的 Spotify 年度总结","content":"为什么要听春日影😡\n[图片]","create_at":1701314331,"topic_period":"2023-11"},"14014812":{"id":14014812,"topic_id":996431,"commenter":"barkure","thank_count":1,"no":68,"topic_title":"看看大家的 Spotify 年度总结","content":"@inhzus #7\n[图片]\n[图片]\n[图片]\n我也是 伍 佰 ！","create_at":1701354120,"topic_period":"2023-11"},"14077674":{"id":14077674,"topic_id":1000609,"commenter":"dobelee","thank_count":1,"no":2,"topic_title":"关于 Spotify 有些想咨询下","content":"spotify 登陆后不需要代理。但是有的区需要 14 天回国一次，有的不用，菲律宾就不用。","create_at":1702610394,"topic_period":"2023-12"},"14078952":{"id":14078952,"topic_id":1000609,"commenter":"dustookk","thank_count":2,"no":20,"topic_title":"关于 Spotify 有些想咨询下","content":"我比较喜欢 QQ 音乐的“猜你喜欢”和网易云音乐的“私人漫游”，永远切不完。\nSpotify 也有每日推荐歌单 1 、2 、3 、4 ，不过他就是固定的几个歌单，没有漫游的感觉。\nSpotify 美区有一个功能是 AIDJ, 有点类似私人漫游，但听下来大部分都是自己收藏的歌曲。\n切到土耳其区以后 ，AIDJ 功能也没有了。","create_at":1702624057,"topic_period":"2023-12"},"14182868":{"id":14182868,"topic_id":1007207,"commenter":"lemoncake07","thank_count":1,"no":6,"topic_title":"spotify 被墙了?","content":"@liuguangxuan 我去贴吧看了一圈，据说是 ipv4 被墙了。手机流量是 ipv6 所以暂时没有受到影响。","create_at":1704790710,"topic_period":"2024-01"},"14203155":{"id":14203155,"topic_id":1008479,"commenter":"nomytwins","thank_count":19,"no":4,"topic_title":"Spotify 被墙，如何破局","content":"这还算事？","create_at":1705202850,"topic_period":"2024-01"},"14203430":{"id":14203430,"topic_id":1008479,"commenter":"by","thank_count":1,"no":16,"topic_title":"Spotify 被墙，如何破局","content":"网易和 QQ 音乐是允许你用的。劝你不要偷听敌台","create_at":1705211207,"topic_period":"2024-01"},"14714233":{"id":14714233,"topic_id":1040388,"commenter":"phew","thank_count":1,"no":1,"topic_title":"Spotify 的播客有办法下载 mp3 吗？","content":"spotify 的播客基本托管在 anchor 的，可以去 anchor 搜索，网页可以用猫抓啥的扒下来。\n不过播客这个东西，不是独家付费的话，一般会 RSS 四处分发的。（讲究的播客会给下载直链）","create_at":1715615402,"topic_period":"2024-05"},"14806154":{"id":14806154,"topic_id":1046093,"commenter":"PopeyeLau","thank_count":1,"no":5,"topic_title":"Spotify HK 节点好少","content":"https://github.com/whoeevee/EeveeSpotify","create_at":1717305433,"topic_period":"2024-06"}}}